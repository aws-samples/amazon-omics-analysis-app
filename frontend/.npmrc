# Supply-chain hardening (requires npm 11.10.0 or later). See docs/development.md.

# Fail the install if a dependency has install scripts that are not reviewed in "allowScripts" of package.json
strict-allow-scripts=true

# Do not resolve package versions published less than 1 day ago (npm install / npm update).
# Versions already locked in package-lock.json are installed by npm ci regardless of this setting.
min-release-age=1

# Do not fetch dependencies from git repositories or remote tarball URLs
allow-git=none
allow-remote=none
